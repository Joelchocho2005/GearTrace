function matchesFilter(order: WorkOrder, term: string): boolean {
  if (!term) return true;
  const haystack = [
    order.number,
    order.description,
    order.vehicle?.plate,
    order.vehicle?.make,
    order.vehicle?.model,
    order.vehicle?.owner?.name,
    order.mechanic?.name,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return haystack.includes(term);
}

