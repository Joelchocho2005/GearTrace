      </span>
    ),
  },
  { key: 'balance', header: 'Saldo', align: 'right', render: (movement) => movement.balanceAfter },
  { key: 'reason', header: 'Motivo', hideOnMobile: true, render: (movement) => movement.reason ?? EMPTY },
