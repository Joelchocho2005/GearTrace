// ============================================================
// GearTrace - Prisma Schema
// Base de datos: PostgreSQL 15
// ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// Role: Roles del sistema
//
//  GERENTE  → Acceso total: inventario, LEDs, usuarios, reportes
//  MECANICO → Acceso operativo: inventario + control de LEDs
//  CLIENTE  → Acceso de solo lectura: consulta de piezas
// ────────────────────────────────────────────────────────────
enum Role {
  GERENTE
  MECANICO
  BODEGUERO
  CONTADOR
  CLIENTE
  PROVEEDOR
}

// Flujo SER (ver src/work-orders/work-order-rules.ts):
// EN_DIAGNOSTICO → ESPERA_APROBACION (presupuesto) → EN_PROCESO ⇄ ESPERA_REPUESTOS
// → CONCLUIDO (cierre técnico del mecánico) → ENTREGADA (con factura activa).
// CANCELADA: el cliente rechaza el presupuesto o el GERENTE cancela (devuelve stock).
enum WorkOrderStatus {
  EN_DIAGNOSTICO
  ESPERA_APROBACION
  EN_PROCESO
  ESPERA_REPUESTOS
  CONCLUIDO
  ENTREGADA
  CANCELADA
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  COMPLETADA
  CANCELADA
  NO_ASISTIO
}

enum PurchaseOrderStatus {
  PENDIENTE
  CONFIRMADA
  RECIBIDA_PARCIAL
  RECIBIDA
  CANCELADA
  RECHAZADA
}

// PARCIAL y PAGADA se derivan de los pagos registrados (Payment).
// ANULADA: comprobante anulado (nunca se borra; conserva su número FAC-).
enum InvoiceStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

enum InvoiceLineType {
  MANO_OBRA
  REPUESTO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

// Kardex: todo cambio de Part.quantity deja un StockMovement.
enum StockMovementType {
  INVENTARIO_INICIAL
  ENTRADA_COMPRA
  SALIDA_OT
  DEVOLUCION_OT
  AJUSTE
  DEVOLUCION_PROVEEDOR
}

// PENDIENTE → APROBADA | RECHAZADA (GERENTE) → ATENDIDA (incluida en una OC).
enum ReplenishmentStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  ATENDIDA
}

// ────────────────────────────────────────────────────────────
// User: Usuarios del sistema GearTrace
// ────────────────────────────────────────────────────────────
model User {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(150)
  email String @unique @db.VarChar(255)

  /// Contraseña hasheada con bcrypt (nunca texto plano)
  password String @db.VarChar(255)

  role     Role    @default(CLIENTE)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Historial de búsquedas realizadas por este usuario
  searchLogs SearchLog[]
  vehicles   Vehicle[]
  workOrders WorkOrder[] @relation("AssignedMechanic")
  invoices   Invoice[]   @relation("InvoiceClient")
  supplierId Int?        @unique @map("supplier_id")
  supplier   Supplier?   @relation("SupplierUser", fields: [supplierId], references: [id], onDelete: SetNull)

  serviceActivities     ServiceActivity[]
  paymentsReceived      Payment[]              @relation("PaymentReceiver")
  voidedInvoices        Invoice[]              @relation("InvoiceVoider")
  stockMovements        StockMovement[]
  replenishmentRequests ReplenishmentRequest[] @relation("ReplenishmentRequester")
  replenishmentReviews  ReplenishmentRequest[] @relation("ReplenishmentReviewer")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("users")
}

// ────────────────────────────────────────────────────────────
// Box: Caja física en el almacén
//
//  - ledIndex: Índice del LED en la tira WS2812B (0-4).
//              Cuando Alexa localiza una pieza, este índice
//              determina qué LED se enciende físicamente.
//  - location: Referencia textual adicional (ej: "Estante A, Nivel 2")
// ────────────────────────────────────────────────────────────
model Box {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  /// Índice del LED en la tira WS2812B (0 a 4, inclusive)
  /// Debe ser único: cada caja tiene su propio LED
  ledIndex Int @unique @map("led_index")

  location String? @db.VarChar(150)
  colorHex String  @default("#FF6600") @map("color_hex") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación: Una caja contiene muchas piezas
  parts Part[]

  @@map("boxes")
}

// ────────────────────────────────────────────────────────────
// Part: Pieza mecánica almacenada en una caja
//
//  - code:     Código único de referencia de la pieza
//  - quantity: Stock actual de unidades en la caja
//  - photoUrl: URL de imagen de la pieza (local o CDN)
//  - keywords: Array de alias/sinónimos para búsqueda por voz
//              (Alexa puede decir "filtro de aceite" o "filtro")
// ────────────────────────────────────────────────────────────
model Part {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(150)

  /// Código de catálogo único (ej: "FLT-OIL-001")
  code String @unique @db.VarChar(50)

  /// Stock actual de unidades
  quantity Int @default(0)

  /// Foto de la pieza (puede ser null si no tiene imagen aún)
  photoUrl String? @map("photo_url") @db.VarChar(500)

  /// Descripción técnica de la pieza
  description String? @db.Text

  /// Palabras clave para búsqueda por voz con Alexa
  /// Se almacena como array de strings en PostgreSQL
  keywords String[] @default([])

  /// Stock mínimo antes de alertar reabastecimiento
  minStock Int @default(1) @map("min_stock")

  /// Precio unitario de VENTA (se congela en UsedPart al consumir)
  unitPrice Decimal? @map("unit_price") @db.Decimal(10, 2)

  /// Costo unitario promedio ponderado (se actualiza al recibir compras)
  costPrice Decimal? @map("cost_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación: Una pieza pertenece a una sola caja
  boxId                 Int                    @map("box_id")
  box                   Box                    @relation(fields: [boxId], references: [id], onDelete: Restrict)
  purchaseOrderItems    PurchaseOrderItem[]
  usedParts             UsedPart[]
  stockMovements        StockMovement[]
  supplierParts         SupplierPart[]
  replenishmentRequests ReplenishmentRequest[]

  @@index([name])
  @@index([boxId])
  @@map("parts")
}

// ────────────────────────────────────────────────────────────
// SearchLog: Historial de búsquedas por voz (Alexa)
//
//  Registra cada vez que Alexa busca una pieza.
//  Útil para analítica y depuración del Webhook.
// ────────────────────────────────────────────────────────────
model SearchLog {
  id Int @id @default(autoincrement())

  /// El texto que Alexa recibió del usuario
  query String @db.VarChar(255)

  /// La pieza encontrada (null si no se encontró)
  partId Int? @map("part_id")

  /// ¿Se encontró la pieza?
  found Boolean @default(false)

  /// Respuesta que se devolvió a Alexa (para auditoría)
  alexaResponse String? @map("alexa_response") @db.Text

  /// Usuario que realizó la búsqueda (null si fue Alexa directo)
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([userId])
  @@map("search_logs")
}

model Vehicle {
  id      Int     @id @default(autoincrement())
  plate   String  @unique @db.VarChar(20)
  make    String  @db.VarChar(80)
  model   String  @db.VarChar(80)
  year    Int?
  vin     String? @unique @db.VarChar(17)
  color   String? @db.VarChar(50)
  ownerId Int     @map("owner_id")
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  workOrders   WorkOrder[]
  appointments Appointment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("vehicles")
}

model WorkOrder {
  id                    Int                    @id @default(autoincrement())
  number                String                 @unique @db.VarChar(30)
  description           String                 @db.Text
  diagnosis             String?                @db.Text
  /// Kilometraje del vehículo al ingresar al taller
  mileage               Int?
  status                WorkOrderStatus        @default(EN_DIAGNOSTICO)
  estimatedCost         Decimal?               @map("estimated_cost") @db.Decimal(10, 2)
  finalCost             Decimal?               @map("final_cost") @db.Decimal(10, 2)
  vehicleId             Int                    @map("vehicle_id")
  mechanicId            Int?                   @map("mechanic_id")
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  mechanic              User?                  @relation("AssignedMechanic", fields: [mechanicId], references: [id], onDelete: SetNull)
  /// Cita que originó la orden (una cita genera como máximo una OT)
  appointmentId         Int?                   @unique @map("appointment_id")
  appointment           Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  parts                 UsedPart[]
  activities            ServiceActivity[]
  /// Historial de comprobantes; solo uno puede estar activo (no ANULADA).
  invoices              Invoice[]
  replenishmentRequests ReplenishmentRequest[]

  /// Presupuesto enviado al cliente (EN_DIAGNOSTICO → ESPERA_APROBACION)
  quoteSentAt    DateTime? @map("quote_sent_at")
  /// Decisión del cliente sobre el presupuesto (true aprobado, false rechazado)
  quoteApproved  Boolean?  @map("quote_approved")
  quoteDecidedAt DateTime? @map("quote_decided_at")
  cancelReason   String?   @map("cancel_reason") @db.VarChar(255)
  cancelledAt    DateTime? @map("cancelled_at")
  deliveredAt    DateTime? @map("delivered_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([vehicleId])
  @@index([mechanicId])
  @@index([status])
  @@map("work_orders")
}

model Appointment {
  id          Int               @id @default(autoincrement())
  scheduledAt DateTime          @map("scheduled_at")
  reason      String?           @db.VarChar(255)
  status      AppointmentStatus @default(AGENDADA)
  vehicleId   Int               @map("vehicle_id")
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId, scheduledAt])
  @@map("appointments")
}

// ────────────────────────────────────────────────────────────
// UsedPart: Repuesto consumido en una orden de trabajo (SER)
//
//  RF-INV-13: descuenta stock al registrarse (StockMovement SALIDA_OT).
// ────────────────────────────────────────────────────────────
model UsedPart {
  id          Int       @id @default(autoincrement())
  quantity    Int
  /// Precio unitario de la pieza al momento del consumo (para facturar)
  unitPrice   Decimal?  @map("unit_price") @db.Decimal(10, 2)
  workOrderId Int       @map("work_order_id")
  partId      Int       @map("part_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part        Part      @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, partId])
  @@index([partId])
  @@map("used_parts")
}

// ────────────────────────────────────────────────────────────
// ServiceActivity: actividad de servicio registrada por el mecánico.
//  Horas × tarifa congelada (WorkshopSettings.laborRatePerHour) = mano de obra.
// ────────────────────────────────────────────────────────────
model ServiceActivity {
  id          Int       @id @default(autoincrement())
  description String    @db.VarChar(255)
  hours       Decimal   @db.Decimal(6, 2)
  /// Tarifa por hora vigente al registrar la actividad (congelada)
  laborRate   Decimal   @map("labor_rate") @db.Decimal(10, 2)
  performedAt DateTime  @default(now()) @map("performed_at")
  workOrderId Int       @map("work_order_id")
  mechanicId  Int       @map("mechanic_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  mechanic    User      @relation(fields: [mechanicId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workOrderId])
  @@index([mechanicId])
  @@map("service_activities")
}

// ────────────────────────────────────────────────────────────
// WorkshopSettings: parámetros del taller (fila única id = 1).
// ────────────────────────────────────────────────────────────
model WorkshopSettings {
  id                     Int     @id @default(1)
  laborRatePerHour       Decimal @default(0) @map("labor_rate_per_hour") @db.Decimal(10, 2)
  /// Tasa de impuesto como fracción (0.15 = 15 %)
  taxRate                Decimal @default(0) @map("tax_rate") @db.Decimal(5, 4)
  appointmentSlotMinutes Int     @default(60) @map("appointment_slot_minutes")
  appointmentsPerSlot    Int     @default(2) @map("appointments_per_slot")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workshop_settings")
}

// ────────────────────────────────────────────────────────────
// StockMovement: kardex. `quantity` con signo; `balanceAfter` = stock resultante.
// ────────────────────────────────────────────────────────────
model StockMovement {
  id              Int               @id @default(autoincrement())
  type            StockMovementType
  quantity        Int
  balanceAfter    Int               @map("balance_after")
  reason          String?           @db.VarChar(255)
  partId          Int               @map("part_id")
  userId          Int?              @map("user_id")
  workOrderId     Int?              @map("work_order_id")
  purchaseOrderId Int?              @map("purchase_order_id")
  part            Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([partId, createdAt])
  @@index([workOrderId])
  @@index([purchaseOrderId])
  @@map("stock_movements")
}

// ────────────────────────────────────────────────────────────
// ReplenishmentRequest: solicitud de reposición (ABA).
// ────────────────────────────────────────────────────────────
model ReplenishmentRequest {
  id              Int                 @id @default(autoincrement())
  quantity        Int
  reason          String?             @db.VarChar(255)
  status          ReplenishmentStatus @default(PENDIENTE)
  reviewNote      String?             @map("review_note") @db.VarChar(255)
  reviewedAt      DateTime?           @map("reviewed_at")
  partId          Int                 @map("part_id")
  requestedById   Int                 @map("requested_by_id")
  reviewedById    Int?                @map("reviewed_by_id")
  /// OT que espera la pieza (opcional)
  workOrderId     Int?                @map("work_order_id")
  /// OC que atiende la solicitud
  purchaseOrderId Int?                @map("purchase_order_id")
  part            Part                @relation(fields: [partId], references: [id], onDelete: Restrict)
  requestedBy     User                @relation("ReplenishmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy      User?               @relation("ReplenishmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([partId])
  @@index([purchaseOrderId])
  @@map("replenishment_requests")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(150)
  taxId          String?         @unique @map("tax_id") @db.VarChar(50)
  contactName    String?         @map("contact_name") @db.VarChar(150)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(50)
  address        String?         @db.VarChar(255)
  purchaseOrders PurchaseOrder[]
  catalog        SupplierPart[]
  user           User?           @relation("SupplierUser")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ────────────────────────────────────────────────────────────
// SupplierPart: catálogo del proveedor (precio y plazo por pieza).
// ────────────────────────────────────────────────────────────
model SupplierPart {
  id           Int      @id @default(autoincrement())
  supplierCode String?  @map("supplier_code") @db.VarChar(50)
  price        Decimal  @db.Decimal(10, 2)
  leadTimeDays Int?     @map("lead_time_days")
  supplierId   Int      @map("supplier_id")
  partId       Int      @map("part_id")
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([supplierId, partId])
  @@index([partId])
  @@map("supplier_parts")
}

model PurchaseOrder {
  id                    Int                    @id @default(autoincrement())
  number                String                 @unique @db.VarChar(30)
  status                PurchaseOrderStatus    @default(PENDIENTE)
  orderedAt             DateTime               @default(now()) @map("ordered_at")
  receivedAt            DateTime?              @map("received_at")
  expectedDeliveryAt    DateTime?              @map("expected_delivery_at")
  supplierId            Int                    @map("supplier_id")
  supplier              Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                 PurchaseOrderItem[]
  replenishmentRequests ReplenishmentRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  quantity         Int
  /// Unidades ya recibidas (recepción parcial)
  receivedQuantity Int           @default(0) @map("received_quantity")
  unitPrice        Decimal?      @map("unit_price") @db.Decimal(10, 2)
  purchaseOrderId  Int           @map("purchase_order_id")
  partId           Int           @map("part_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part             Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, partId])
  @@index([partId])
  @@map("purchase_order_items")
}

// ────────────────────────────────────────────────────────────
// Invoice: comprobante interno de una orden de trabajo (FIN)
//
//  - Se arma con InvoiceLine (MANO_OBRA de ServiceActivity y REPUESTO de
//    UsedPart, precios congelados); subtotal = Σ líneas, tax = subtotal × taxRate.
//  - Una OT tiene a lo sumo una factura activa (no ANULADA); se valida con la
//    OT bloqueada (FOR UPDATE) en InvoicesService.
//  - Nunca se borra: se anula (voidedAt, voidReason, voidedById).
// ────────────────────────────────────────────────────────────
model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique @db.VarChar(30)
  subtotal    Decimal       @db.Decimal(10, 2)
  /// Tasa aplicada (congelada desde WorkshopSettings)
  taxRate     Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 4)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  /// Σ pagos registrados
  paidAmount  Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status      InvoiceStatus @default(PENDIENTE)
  notes       String?       @db.VarChar(255)
  issuedAt    DateTime      @default(now()) @map("issued_at")
  paidAt      DateTime?     @map("paid_at")
  voidedAt    DateTime?     @map("voided_at")
  voidReason  String?       @map("void_reason") @db.VarChar(255)
  voidedById  Int?          @map("voided_by_id")
  workOrderId Int           @map("work_order_id")
  clientId    Int           @map("client_id")
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  client      User          @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: Restrict)
  voidedBy    User?         @relation("InvoiceVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workOrderId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          Int             @id @default(autoincrement())
  type        InvoiceLineType
  description String          @db.VarChar(255)
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  invoiceId   Int             @map("invoice_id")
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id           Int           @id @default(autoincrement())
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?       @db.VarChar(100)
  paidAt       DateTime      @default(now()) @map("paid_at")
  invoiceId    Int           @map("invoice_id")
  receivedById Int           @map("received_by_id")
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy   User          @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

// ────────────────────────────────────────────────────────────
// Notification: avisos internos por usuario (stock bajo, presupuestos, etc.).
// ────────────────────────────────────────────────────────────
model Notification {
  id      Int       @id @default(autoincrement())
  title   String    @db.VarChar(150)
  message String    @db.VarChar(500)
  /// Ruta del frontend relacionada (p. ej. /ordenes-trabajo)
  link    String?   @db.VarChar(255)
  readAt  DateTime? @map("read_at")
  userId  Int       @map("user_id")
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ────────────────────────────────────────────────────────────
// AuditLog: quién cambió qué (estados, precios, stock, anulaciones, pagos).
// ────────────────────────────────────────────────────────────
model AuditLog {
  id       Int    @id @default(autoincrement())
  action   String @db.VarChar(80)
  entity   String @db.VarChar(50)
  entityId Int?   @map("entity_id")
  detail   Json?
  userId   Int?   @map("user_id")
  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

